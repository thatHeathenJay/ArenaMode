<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Shared.props" />
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>maschine-ArenaMode.Fika</AssemblyName>
    <RootNamespace>ArenaMode.Fika</RootNamespace>
    <Description>Co-op arena on Fika: in-place respawn on Fika's downed primitive, match-state sync (companion plugin)</Description>
    <SPTModType>Client</SPTModType>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Configurations>Debug;Release</Configurations>
    <NoWarn>CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ArenaMode.Client\ArenaMode.Client.csproj" Private="false" />
    <ProjectReference Include="..\..\Redeploy\Redeploy.Core\Redeploy.Core.csproj" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- Fika is a hard runtime dependency of this plugin only; the Arena client itself keeps no Fika reference. -->
    <Reference Include="Fika.Core">
      <HintPath>$(SPTPath)\BepInEx\plugins\Fika\Fika.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp" Private="false" />
    <Reference Include="Comfort" Private="false" />
    <Reference Include="Comfort.Unity" Private="false" />
    <Reference Include="ItemComponent.Types" Private="false" />
    <Reference Include="ItemTemplate.Types" Private="false" />
    <Reference Include="spt-reflection" Private="false" />
    <Reference Include="UnityEngine" Private="false" />
    <Reference Include="UnityEngine.CoreModule" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" Private="false" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
  </ItemGroup>
</Project>
